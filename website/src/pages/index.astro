---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_VERSION, NAV_GROUPS, DOWNLOAD_URL } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/screenshots/hide.png" />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
			}
			.hero {
				padding: 1em 0 2em;
				text-align: center;
			}
			.hero h1 {
				font-size: 3em;
			}
			.hero p {
				font-size: 1.1em;
				color: rgb(var(--gray-dark));
			}
			.badges span {
				display: inline-block;
				margin: 0 0.3em;
				padding: 0.2em 0.7em;
				border-radius: 1em;
				background: rgb(var(--gray-light));
				font-size: 0.8em;
			}
			.actions a {
				display: inline-block;
				margin: 1em 0.3em 0;
				padding: 0.6em 1.2em;
				border-radius: 6px;
				background: var(--accent);
				color: white;
				text-decoration: none;
			}
			.actions a.secondary {
				background: transparent;
				color: var(--accent);
				border: 1px solid var(--accent);
			}
			.shot {
				margin: 1em auto 3em;
				text-align: center;
			}
			.shot img {
				width: 620px;
				max-width: 100%;
				box-shadow: var(--box-shadow);
			}
			.groups {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1em;
			}
			.group {
				padding: 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
			}
			.group h2 {
				font-size: 1.3em;
			}
			.group a {
				display: block;
				padding: 0.2em 0;
			}
			@media (max-width: 760px) {
				.groups {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>文件夹隐藏工具</h1>
				<p>{SITE_DESCRIPTION}</p>
				<div class="badges">
					<span>版本 {SITE_VERSION}</span>
					<span>Windows 10 / 11</span>
					<span>AES-256-GCM</span>
					<span>中 / 英 / 日</span>
				</div>
				<div class="actions">
					<a href={DOWNLOAD_URL}>下载安装包</a>
					<a class="secondary" href="/guide/folder-hide/">阅读使用指南</a>
				</div>
			</section>

			<figure class="shot">
				<img src="/screenshots/hide.png" alt="文件夹隐藏工具主界面" width="620" height="500" />
				<figcaption>主界面：文件夹隐藏、文件加密、文件夹加密与常规设置</figcaption>
			</figure>

			<section class="groups">
				{NAV_GROUPS.map((group) => (
					<div class="group">
						<h2>{group.title}</h2>
						{group.items.map((item) => (
							<a href={item.href}>{item.title}</a>
						))}
					</div>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
