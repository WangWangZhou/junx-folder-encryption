---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { NAV_GROUPS, SITE_TITLE } from "../consts";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const pageTitle = `${title} · ${SITE_TITLE}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={description} image={image} />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2em);
				display: grid;
				grid-template-columns: 220px minmax(0, 1fr);
				gap: 2em;
				padding-top: 2em;
			}
			aside nav {
				position: sticky;
				top: 1em;
				font-size: 0.85em;
			}
			aside h3 {
				margin: 1.2em 0 0.3em;
				font-size: 1em;
			}
			aside a {
				display: block;
				padding: 0.2em 0;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			aside a:hover,
			aside a[aria-current="page"] {
				color: var(--accent);
			}
			article {
				min-width: 0;
			}
			article h1 {
				font-size: 2.2em;
			}
			figure {
				margin: 1.5em 0;
			}
			figure img {
				display: block;
				width: 100%;
				border: 1px solid rgb(var(--gray-light));
				box-shadow: var(--box-shadow);
			}
			figcaption {
				margin-top: 0.5em;
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-align: center;
			}
			.steps {
				padding-left: 1.5em;
			}
			.steps li {
				margin-bottom: 0.8em;
			}
			.note {
				padding: 0.8em 1em;
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 40%);
				border-radius: 0 6px 6px 0;
			}
			@media (max-width: 860px) {
				main {
					grid-template-columns: 1fr;
				}
				aside nav {
					position: static;
					padding-bottom: 1em;
					border-bottom: 1px solid rgb(var(--gray-light));
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<aside>
				<nav aria-label="文档目录">
					{NAV_GROUPS.map((group) => (
						<>
							<h3>{group.title}</h3>
							{group.items.map((item) => (
								<a
									href={item.href}
									aria-current={Astro.url.pathname === item.href ? "page" : undefined}
								>
									{item.title}
								</a>
							))}
						</>
					))}
				</nav>
			</aside>
			<article>
				<h1>{title}</h1>
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
